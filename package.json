{
  "name": "endkind.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tasks:clean": "rm -rf scripts/dist",
    "tasks:run": "pnpm run tasks:clean && tsc -p tsconfig.scripts.json && tsc-alias -p tsconfig.scripts.json && node scripts/dist/scripts/tasks.js",
    "dev": "pnpm run tasks:run && vite",
    "build": "pnpm run tasks:run && vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "daisyui": "^5.5.19",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vue-tsc": "^3.2.7",
    "tsc-alias": "^1.8.16"
  }
}
