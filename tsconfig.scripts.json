{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@src/*": ["./src/*"]
    },
    "outDir": "./scripts/dist",
    "rootDir": "."
  },
  "include": ["scripts/**/*.ts"]
}

